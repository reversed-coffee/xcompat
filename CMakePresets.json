{
  "version": 3,
  "configurePresets": [
    {
      "name": "x86_64-Debug",
      "displayName": "Debug (NT, x86_64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-Release",
      "displayName": "Release (NT, x86_64)",
      "inherits": "x86_64-Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
